# config.example.env — Konfiguration för finland-MCP-servern
# Kopiera till .env och fyll i dina värden.
# .env checkas ALDRIG in i Git.

# ── Databas ───────────────────────────────────────────────────────────────────
# PostgreSQL (krävs för semantisk sökning med pgvector)
DATABASE_URL=postgresql://<db_anvandare>:<db_losenord>@localhost:5432/<db_namn>

# SQLite (semantisk sökning inaktiveras)
# DATABASE_URL=sqlite:///finland_cache.db

# ── MCP-transport ─────────────────────────────────────────────────────────────
# stdio: MCP-klienten startar processen (för lokal användning)
MCP_TRANSPORT=stdio

# http: servern lyssnar på MCP_HOST:MCP_PORT (för hostad driftsättning)
# MCP_TRANSPORT=http
# MCP_HOST=127.0.0.1
# MCP_PORT=8005
# MCP_API_KEY=generera_med_python3_-c_"import_secrets;print(secrets.token_hex(32))"

# ── Embeddingmodeller (tvåspråkig arkitektur) ─────────────────────────────────
# Finska: TurkuNLP (768 dim) — indexerar finsk text, söker finska frågor
EMBEDDING_MODEL_FI=TurkuNLP/sbert-cased-finnish-paraphrase

# Svenska: KBLab (768 dim) — indexerar svensk text, söker svenska frågor
EMBEDDING_MODEL_SV=KBLab/sentence-bert-swedish-cased

# ── Query-expansion via LLM (valfritt) ────────────────────────────────────────
# Expanderar söktermer till juridisk terminologi på finska och svenska.
# Kräver en OpenAI-kompatibel endpoint (Claude, OpenAI, Ollama, LM Studio, ...).
QUERY_EXPANSION_ENABLED=false
# QUERY_EXPANSION_BASE_URL=http://localhost:11434/v1
# QUERY_EXPANSION_API_KEY=din-api-nyckel
# QUERY_EXPANSION_MODEL=llama3.2

# ── Daglig schemaläggning ─────────────────────────────────────────────────────
# Kör: python3 01_synka_finlex.py --installera-schema
#
# launchd (macOS — kör även om datorn sov vid schemalagd tid, rekommenderas)
SCHEMALAGGARE=launchd
CRON_SCHEMA=15 4 * * *
#
# cron (Linux och macOS)
# SCHEMALAGGARE=cron
# CRON_SCHEMA=15 4 * * *

# ── API-konfiguration ─────────────────────────────────────────────────────────
# Eduskunta API-bas (ändra normalt inte)
EDUSKUNTA_API_BASE=https://api.eduskunta.fi/api/v1

# Finlex API-bas (ändra normalt inte)
FINLEX_API_BASE=https://opendata.finlex.fi/finlex/avoindata/v1

# Rate-limiting (anrop per minut)
EDUSKUNTA_RATE_LIMIT=60
FINLEX_RATE_LIMIT=20
